# --- Database -----------------------------------------------------------------
# CalSight's shared dev DB lives on VM 109 ("docker-dev") on Jeff's home
# Proxmox server. Reach it via Tailscale — works from anywhere once you're
# added to the tailnet and have Tailscale installed locally.
#
# Ask an operator for a Tailscale invite. Obtain the DB password from the
# team's secret manager (or a direct 1:1 share from an operator) — do not
# request or share it in chat. The shared password is rotated periodically,
# so re-fetch the current value if your connection starts failing.
DATABASE_URL=postgresql://calsight_team:CHANGE_ME@<tailscale-ip>:5433/calsight

# Alternative: spin up a fresh empty local Postgres in Docker for offline work.
# Run `docker compose --profile local-db up -d db`, then use the URL below.
# Note: empty DB — no crash data unless you re-run the ETL scripts.
# DATABASE_URL=postgresql://calsight:calsight_dev@db:5432/calsight

# --- CORS ---------------------------------------------------------------------
# Comma-separated origins. Native vite dev runs on 5173; Docker maps to 5180.
CORS_ORIGINS=http://localhost:5173,http://localhost:5180

# --- API keys (shared values live in the team secret manager) -----------------
CENSUS_API_KEY=
NOAA_API_TOKEN=
BLS_API_KEY=

# --- App ----------------------------------------------------------------------
# Set to false in production to disable debug mode and auto-docs.
DEBUG=true

# Maintenance mode: set to true and restart the API to take the app offline
# gracefully (503 + Retry-After on all /api/* except /api/health) during a
# server/DB migration. Leave false for normal operation.
MAINTENANCE_MODE=false

# --- LLM (AI insight card generation) -----------------------------------------
# Used by etl/generate_insights.py to produce per-county narrative blurbs.
# Supported providers: groq | openrouter | together | cerebras | ollama
# Leave LLM_MODEL and LLM_BASE_URL empty to use provider defaults.
# For ollama over Tailscale, set LLM_BASE_URL to http://<tailscale-ip>:11434/v1
LLM_PROVIDER=together
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Sampling temperature for AI answers. Low (0.3-0.5) keeps a factual data tool
# accurate and consistent; higher values drift. Default 0.4.
LLM_TEMPERATURE=0.4
# Optional spending backstop: max LLM provider calls per day across paid
# providers (0 = unlimited, the default). The counter is in-process and
# per-worker — like the API rate limits — so with 4 gunicorn workers the
# effective daily cap is 4x this value, and it resets on restart. Local
# ollama calls are free and never counted. When the budget is spent,
# /api/ask degrades gracefully instead of calling paid providers.
LLM_DAILY_REQUEST_BUDGET=0

# --- ETL Pipeline -------------------------------------------------------------
# API key for triggering ETL runs via POST /api/etl/run (optional).
ETL_API_KEY=

# Separate credential for the admin UI (/admin/verify). Falls back to
# ETL_API_KEY when empty, but setting a distinct value means rotating one
# secret never locks out the other.
ADMIN_API_KEY=

# Discord or Slack webhook URL for pipeline failure alerts.
# Leave empty to disable webhook notifications (alerts still go to logs).
ALERT_WEBHOOK_URL=

# Backup directory (default: /opt/calsight/backups on the Proxmox host).
BACKUP_DIR=/opt/calsight/backups

# Sentry error monitoring. Leave SENTRY_DSN empty to disable (no-op).
# Backend reads SENTRY_DSN; the frontend reads VITE_SENTRY_DSN (set in
# frontend/.env). Create a project at sentry.io to get a DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Dead-man's-switch heartbeat (e.g. a healthchecks.io check URL). The backup
# job pings this on success; if pings stop, the external monitor alerts you —
# catching a dead box that webhook alerts can't. Leave empty to disable.
HEARTBEAT_URL=
